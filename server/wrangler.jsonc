{
  // REVERB multiplayer server. `npm run dev` for local, `npm run deploy` to publish.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "reverb-mp",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  // served only from our own domain; the account's workers.dev URL is switched off
  // api.playreverb.com is the server; reverb-api.patrickglover.io stays for a while so tabs opened before the move
  // to playreverb.com keep working (remove it, and https://patrickglover.io below, once nobody can be on the old page)
  "routes": [
    { "pattern": "api.playreverb.com", "custom_domain": true },
    { "pattern": "reverb-api.patrickglover.io", "custom_domain": true }
  ],
  "workers_dev": false,
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" },
      { "name": "STATS", "class_name": "Stats" },
      { "name": "MATCHER", "class_name": "Matcher" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room", "Stats"] },
    { "tag": "v2", "new_sqlite_classes": ["Matcher"] }
  ],
  // per-IP limits (approximate, per Cloudflare location; see limited() in src/index.js). Periods must be 10 or 60 s.
  // A browser's rejoin loop makes ~1 lookup + 1 connect every 1-2 s for 25 s, which fits under these.
  "ratelimits": [
    { "name": "RL_CREATE", "namespace_id": "2001", "simple": { "limit": 12, "period": 60 } },  // POST /api/rooms, /api/quick
    { "name": "RL_LOOKUP", "namespace_id": "2002", "simple": { "limit": 60, "period": 60 } },  // GET /api/rooms/:code, /api/quick
    { "name": "RL_CONNECT", "namespace_id": "2003", "simple": { "limit": 40, "period": 60 } }  // WebSocket connects
  ],
  "observability": { "enabled": true },
  "vars": {
    // origins allowed to create/join rooms ("null" = the game opened from file://)
    "ALLOWED_ORIGINS": "https://playreverb.com,https://www.playreverb.com,https://patrickglover.io,http://localhost:8000,http://127.0.0.1:8000,null"
  }
  // secret: ADMIN_TOKEN  (wrangler secret put ADMIN_TOKEN; locally in .dev.vars)
  // secret: NTFY_TOPIC   (optional; traffic alerts to https://ntfy.sh/<topic>, see docs/MULTIPLAYER.md Ops)
}
